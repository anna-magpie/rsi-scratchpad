---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <link href="{{ '/' | absolute_url }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ '/' | absolute_url }}</id>
  {% for p in site.posts limit: 20 %}
  <entry>
    <title>{{ p.title | xml_escape }}</title>
    <link href="{{ p.url | absolute_url }}"/>
    <id>{{ p.url | absolute_url }}</id>
    <updated>{{ p.date | date_to_xmlschema }}</updated>
    <summary>{{ p.summary | default: p.excerpt | strip_html | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
